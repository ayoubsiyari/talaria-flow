# Secrets — only .env.example is tracked
.env
.env.*
!.env.example

# Dependencies and tool output
node_modules/
.vercel/
.next/
.pnpm-store/
*.log

# Generated by `pnpm build` (scripts/build.mjs) from src/ and emails/
public/assets/js/i18n.js
public/assets/js/env.js
public/assets/js/emails-render.js
public/assets/js/tutorial/*.js
public/assets/emails/

# Local uploads, test artefacts, reports
uploads/
test-results/
playwright-report/
# Lighthouse: scores live in docs/lighthouse/README.md; HTML/JSON reports are local-only
docs/lighthouse/*.json
docs/lighthouse/*.html
*.zip

# Editor / agent tooling
.agents/
.claude/
.codex/
.cursor/
.impeccable/
.vscode/
.idea/
.DS_Store
Thumbs.db
