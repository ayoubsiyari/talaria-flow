# Talaria Flow — environment variables
# Copy to .env and fill in. Never commit .env. Keys marked PUBLIC are safe in the browser
# (scripts/build.mjs copies only those into public/assets/js/env.js); everything else is read
# only by api/* functions, middleware.ts and scripts/.
#
# REQUIRED in production (Vercel → Settings → Environment Variables): SITE_URL, SUPABASE_URL,
# SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY,
# UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN (or the KV_* pair), RESEND_API_KEY, RESEND_FROM,
# RESEND_WEBHOOK_SECRET, CRON_SECRET. COURSE_RELEASED is public and stays empty until the course ships.
# With any VERCEL_ENV (production or preview) the API fails closed when Turnstile,
# the rate-limit store or Resend is missing (500 turnstile_unconfigured / ratelimit_unconfigured /
# failed email_events row) instead of silently degrading.

# ---- Site ------------------------------------------------------------------
# REQUIRED. Canonical origin, no trailing slash. Used in emails (links, unsubscribe), sitemap, redirects. (PUBLIC)
SITE_URL=https://www.talaria-flow.com

# ---- Supabase (Project Settings -> API) --------------------------------------
# REQUIRED. Project URL shown to the browser. (PUBLIC)
SUPABASE_URL=https://your-project-id.supabase.co
# Optional on a VPS. Server-side Auth/REST calls (login, signup, middleware) use this instead of
# SUPABASE_URL so they do not depend on public DNS. Example: http://127.0.0.1:8000
# SUPABASE_INTERNAL_URL=http://127.0.0.1:8000
# REQUIRED. anon key — protected by row-level security. (PUBLIC)
SUPABASE_ANON_KEY=replace-with-anon-key
# REQUIRED. service_role key — server only. Bypasses RLS; used by api/* and scripts/. Also the HMAC key
# for the signed unsubscribe links (src/lib/server/unsubscribe.ts) — rotating it invalidates old links.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Optional. Database connection string (Project Settings -> Database). Used by `supabase db push`, seed.sql and dumps.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ---- Cloudflare Turnstile (dash.cloudflare.com -> Turnstile -> widget, mode: Invisible) ----
# REQUIRED. Site key — rendered in the browser on signup, login, reset and waitlist. (PUBLIC)
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
# REQUIRED in production. Secret key — api/* verifies every token with it. Empty = checks skipped (local dev only).
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# ---- Rate limiting (Upstash Redis or Vercel KV; REST credentials) ------------------
# REQUIRED in production (one pair). 5 attempts / 15 min per IP+email on login, signup, reset, waitlist,
# proof and unsubscribe. Without it production answers 500 ratelimit_unconfigured; locally an in-memory
# window per process is used.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
# Alternative pair when using Vercel KV (same REST protocol):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Email (Office 365 SMTP or Resend) --------------------------------------
# If SMTP_HOST / SMTP_USER / SMTP_PASSWORD are set, transactional mail goes through SMTP
# (Microsoft 365). Otherwise RESEND_API_KEY is used. The From address must be the SMTP mailbox
# when using Office 365 (it rejects a different From).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support-center@talaria-log.com
# REQUIRED in production if SMTP is empty. Empty = no email leaves the machine; locally sends are logged as re_local_* ids.
RESEND_API_KEY=replace-with-resend-key
# Sender shown to members when using Resend. Ignored as envelope From when SMTP is enabled.
RESEND_FROM="Talaria Flow <support@talaria-flow.com>"
# Optional. Signing secret of the Resend webhook (Webhooks -> your endpoint -> Signing secret). Starts with whsec_.
RESEND_WEBHOOK_SECRET=replace-with-webhook-secret

# ---- Sentry (sentry.io -> Project -> Client Keys) -------------------------------
# Optional. Browser + server error reporting. Leave empty to disable. (PUBLIC)
SENTRY_DSN=

# ---- Scheduled jobs ------------------------------------------------------------
# REQUIRED on every Vercel deploy. Random string (openssl rand -hex 32); Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` to api/cron/* (nightly proof purge + abandoned incoming sweep,
# campaign scheduler daily 08:00 UTC). Empty locally is fine; preview/production fail closed without it.
CRON_SECRET=replace-with-random-32-chars

# ---- Course release -----------------------------------------------------------
# PUBLIC. Empty = approved members see a locked curriculum. Set to 1 when the 30-video course ships
# (before 31 Dec 2026). Copied into public/assets/js/env.js.
COURSE_RELEASED=

# ---- Set by Vercel automatically (do not add by hand) ---------------------------
# VERCEL_ENV=production|preview|development   -> env.failClosed (any Vercel env) / env.isProduction, Sentry environment
# VERCEL_GIT_COMMIT_SHA                        -> Sentry release
# NODE_ENV=production is honoured the same way as VERCEL_ENV=production.

# ---- Local / test only -----------------------------------------------------------
# One password for the five *@talaria-flow.test accounts (scripts/create-test-accounts.ts). Staging/local only.
TEST_PASSWORD=replace-with-strong-password
# PORT (dev server, default 5051) · MOCK_PORT (tests/mock-supabase.mjs, default 5099) · SHOTS_DIR (Playwright screenshots)
